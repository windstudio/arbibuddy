{
  "schema_version": "1.0.0",
  "rules": [
    {
      "rule_id": "NAT-OVERTIME-001",
      "version": "1.0.0",
      "applicable_claims": ["工作日延长工时加班工资", "休息日加班工资", "法定休假日加班工资"],
      "jurisdiction": "全国",
      "effective_from": "1995-01-01",
      "effective_to": null,
      "summary": "标准工时制下，用人单位安排工作日延长工时、休息日工作且不能安排补休、法定休假日工作的，分别按不低于150%、200%、300%的标准支付工资报酬",
      "conditions": [
        "存在用人单位安排的超出适用工时制度的工作",
        "工作日延长工时按小时核对，休息日和法定休假日按对应日期性质核对",
        "休息日加班不能安排补休时适用200%工资报酬",
        "工资基数、工时或天数及已付金额均有可核对依据"
      ],
      "exceptions": [
        "综合计算工时、不定时工作制及特殊岗位须先核验审批、周期和地方口径",
        "法定休假日加班不能以补休替代加班工资",
        "工时、工资基数、补休或已付金额缺失或冲突时不得生成伪精确结果"
      ],
      "source_ids": [
        "SRC-NAT-LABOR-LAW-036-044",
        "SRC-NAT-WAGE-PAYMENT-013",
        "SRC-NAT-WAGE-CONVERSION-2025",
        "SRC-NAT-ARBITRATION-006",
        "SRC-NAT-LABOR-INTERPRETATION-042"
      ],
      "verified_on": "2026-07-17",
      "review_on": "2027-01-17"
    }
  ],
