{
  "schema_version": "1.0.0",
  "rules": [
    {
      "rule_id": "NAT-DISPUTE-ROUTING-001",
      "version": "1.0.0",
      "applicable_claims": ["社会保险路径", "住房公积金路径", "六类复杂争议分层"],
      "jurisdiction": "全国基线；上海受理机关、办理程序与地方口径专项增强",
      "effective_from": "2026-07-18",
      "effective_to": null,
      "summary": "缴费事项优先识别行政处理路径，交叉例外使用受控状态；六类复杂争议只进入风险识别与专业复核",
      "conditions": [
        "社会保险和住房公积金缴费问题分别识别征缴、经办、监察、税务或公积金中心候选路径",
        "地区、程序阶段、请求类型和现行口径必须动态核验",
        "工伤、职业病、竞业限制、劳务派遣、股权激励和涉外用工只提供分层支持"
      ],
      "exceptions": [
        "社保待遇损失、解除与经济补偿等可能形成仲裁或诉讼交叉请求，不能与单纯补缴混同",
        "地方受理机关、历史时段分工、程序期限和请求性质变化时必须重新路由",
        "涉外用工的旧就业证条款不得直接作为现行办证流程；2017年起两证整合，工作许可、居留及当地窗口以现行官方指南另核",
        "来源过期、冲突或无法完成动态核验时必须降级为 pending_verification"
      ],
      "local_differences": [
        "上海人社2025年咨询答复称本市各级仲裁机构自2014年7月起不再受理社保缴费争议，可向劳动保障监察投诉或请求社保经办机构依法处理；征收、税务分工及历史欠缴时段需另核，不能由该答复直接推定",
        "上海公积金中心受理单位不缴、少缴投诉并依行政执法程序处理"
      ],
      "source_ids": [
        "SRC-NAT-SOCIAL-INSURANCE", "SRC-SH-SOCIAL-ROUTE", "SRC-NAT-SOCIAL-LOSS",
        "SRC-NAT-HOUSING-FUND", "SRC-SH-HOUSING-COMPLAINT", "SRC-NAT-WORK-INJURY",
        "SRC-NAT-OCCUPATIONAL-DISEASE", "SRC-NAT-NON-COMPETE", "SRC-NAT-LABOR-DISPATCH",
        "SRC-OFFICIAL-EQUITY-INCENTIVE", "SRC-NAT-FOREIGN-EMPLOYMENT"
      ],
      "verified_on": "2026-07-18",
      "review_on": "2026-10-18"
    }
  ],
